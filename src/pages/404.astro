---
import Base from '../layouts/Base.astro';
---
<Base title="Wrong turn" description="This page couldn't be found." noindex>
  <section class="narrow hero">
    <p class="eyebrow">404</p>
    <h1>Looks like we took a <em>wrong turn</em>.</h1>
    <p class="lede">The page you were after isn't here. Let's get you back on the tar.</p>
    <div class="hero__actions"><a class="btn btn--primary" href="/">Back to the homepage</a><a class="btn btn--secondary" href="/search/">Search the stories</a></div>
  </section>
</Base>
