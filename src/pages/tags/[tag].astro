---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, slugify, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---

<Base title={`Stories about ${tag}`} description={`Travel stories tagged “${tag}”.`}>
  <section class="container section">
    <p class="eyebrow">Topic</p>
    <h1>#{tag}</h1>
  </section>
  <section class="container"><div class="grid">{posts.map((p) => <PostCard post={p} />)}</div></section>
</Base>
