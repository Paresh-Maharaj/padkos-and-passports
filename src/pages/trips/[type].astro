---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, TRIP_TYPES, type Post } from '../../lib/posts';
// The words on these pages come from src/data/trips.json,
// which you edit in the editor under Pages → Trip style pages.
import trips from '../../data/trips.json';

export async function getStaticPaths() {
  const posts = await getPosts();
  return (Object.keys(TRIP_TYPES) as (keyof typeof TRIP_TYPES)[]).map((type) => ({
    params: { type },
    props: { type, posts: posts.filter((p) => p.data.tripType === type) },
  }));
}
interface Props { type: keyof typeof TRIP_TYPES; posts: Post[] }
const { type, posts } = Astro.props;
const page = (trips as Record<string, { title?: string; intro?: string } | string | undefined>)[type] as { title?: string; intro?: string } | undefined;
const title = page?.title || TRIP_TYPES[type];
const intro = page?.intro || '';
const empty = (trips as { emptyMessage?: string }).emptyMessage || 'Stories coming soon.';
---

<Base title={title} description={intro || undefined}>
  <section class="container section">
    <p class="eyebrow">Trip style</p>
    <h1>{title}</h1>
    {intro && <p class="lede" style="margin-top:12px">{intro}</p>}
  </section>
  <section class="container">
    {posts.length ? <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div> : <p class="lede">{empty}</p>}
  </section>
</Base>
