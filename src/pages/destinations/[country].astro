---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, slugify, REGIONS, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const countries = [...new Set(posts.map((p) => p.data.country))];
  return countries.map((country) => ({
    params: { country: slugify(country) },
    props: { country, posts: posts.filter((p) => p.data.country === country) },
  }));
}
interface Props { country: string; posts: Post[] }
const { country, posts } = Astro.props;
---

<Base title={`Travel stories from ${country}`} description={`Every trip I've written up in ${country}: where I stayed, what it cost and what I'd do differently.`}>
  <section class="container section">
    <p class="eyebrow"><a href="/destinations/">Destinations</a> · {REGIONS[posts[0].data.region]}</p>
    <h1>{country}</h1>
  </section>
  <section class="container"><div class="grid">{posts.map((p) => <PostCard post={p} />)}</div></section>
</Base>
