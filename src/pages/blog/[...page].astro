---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const title = page.currentPage === 1 ? 'All stories' : `All stories — page ${page.currentPage}`;
---

<Base title={title} description="Every trip, newest first: road trips around South Africa, journeys across Africa and adventures further afield.">
  <section class="container section">
    <p class="eyebrow">The journal</p>
    <h1>{title}</h1>
    <p class="lede" style="margin-top:12px">{page.total} stories and counting.</p>
  </section>
  <section class="container">
    <div class="grid">
      {page.data.map((post, i) => <PostCard post={post} eager={i < 3} />)}
    </div>
    <nav class="pager" aria-label="More stories">
      {page.url.prev ? <a class="btn btn--secondary" href={page.url.prev}>← Newer stories</a> : <span />}
      {page.url.next ? <a class="btn btn--secondary" href={page.url.next}>Older stories →</a> : <span />}
    </nav>
  </section>
</Base>
