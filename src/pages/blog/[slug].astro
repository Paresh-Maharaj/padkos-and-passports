---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import PostCard from '../../components/PostCard.astro';
import SponsorSlot from '../../components/SponsorSlot.astro';
import Newsletter from '../../components/Newsletter.astro';
import settings from '../../data/settings.json';
import { getPosts, formatDate, readingTime, slugify, TRIP_TYPES, REGIONS, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const url = new URL(Astro.url.pathname, Astro.site).href;
const cover = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: (p.data.country === d.country ? 3 : 0) + (p.data.region === d.region ? 1 : 0) + (p.data.tripType === d.tripType ? 1 : 0) + p.data.tags.filter((t) => d.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((x) => x.p);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    image: [new URL(cover.src, Astro.site).href],
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    author: { '@type': 'Person', name: settings.author.name, url: new URL('/about/', Astro.site).href },
    publisher: { '@type': 'Person', name: settings.author.name },
    mainEntityOfPage: url,
    keywords: [d.country, ...d.tags].join(', '),
    contentLocation: { '@type': 'Place', name: d.country },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Stories', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
const enc = encodeURIComponent;
const share = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${enc(`${d.title} ${url}`)}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
  { label: 'Pinterest', href: `https://pinterest.com/pin/create/button/?url=${enc(url)}&description=${enc(d.title)}` },
  { label: 'Email', href: `mailto:?subject=${enc(d.title)}&body=${enc(url)}` },
];
---

<Base title={d.title} description={d.description} image={d.cover} imageAlt={d.coverAlt} type="article" publishedTime={d.date} modifiedTime={d.updated} jsonLd={jsonLd}>
  <article>
    <header class="narrow article-head">
      <div class="tag-row">
        <Tag href={`/trips/${d.tripType}/`} variant={d.tripType}>{TRIP_TYPES[d.tripType]}</Tag>
        <Tag href={`/destinations/${slugify(d.country)}/`} variant={d.region}>{d.country}</Tag>
        {d.sponsored && <Tag variant="sponsored">Sponsored</Tag>}
      </div>
      <h1 data-pagefind-meta="title">{d.title}</h1>
      <p class="lede" style="margin-top:16px">{d.description}</p>
      <p class="article-meta">
        By {settings.author.name} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}
        · {readingTime(post.body)} min read
      </p>
    </header>

    <figure class="container article-cover" style="max-width:1000px">
      <Image src={d.cover} alt={d.coverAlt} widths={[480, 800, 1200, 1600]} sizes="(max-width: 1032px) 100vw, 1000px" loading="eager" fetchpriority="high" data-pagefind-meta="image[src]" />
      <figcaption>{d.coverAlt}</figcaption>
    </figure>

    <div class="narrow stack">
      {d.sponsored && (
        <p class="disclosure"><strong>Sponsored story.</strong> This trip was supported by {(d.sponsorName ?? 'a partner').replace(/\.$/, '')}. As always, the opinions, photos and the occasional grumble are entirely my own. <a href="/disclosure/">How I work with sponsors</a>.</p>
      )}
      <div class="prose">
        <Content />
      </div>

      <div class="share" aria-label="Share this story">
        <span class="eyebrow">Share</span>
        {share.map((s) => <a class="tag" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>

      {d.tags.length > 0 && (
        <div class="tag-row" aria-label="Topics">
          {d.tags.map((t) => <Tag href={`/tags/${slugify(t)}/`}>#{t}</Tag>)}
        </div>
      )}

      <div class="author-box" data-pagefind-ignore>
        <p class="eyebrow">About the author</p>
        <p>{settings.author.shortBio} <a href="/about/">More about me</a>.</p>
      </div>

      <SponsorSlot />
    </div>
  </article>

  {related.length > 0 && (
    <section class="container section" data-pagefind-ignore>
      <div class="section-head"><h2>You might also enjoy</h2></div>
      <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <section class="container" data-pagefind-ignore>
    <Newsletter />
  </section>
</Base>
