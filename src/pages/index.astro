---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import TravelMap from '../components/map/TravelMap.astro';
import { getPosts, REGIONS } from '../lib/posts';
import home from '../data/homepage.json';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const latest = posts.filter((p) => p !== featured).slice(0, 6);
const count = (r: string) => posts.filter((p) => p.data.region === r).length;
// All the words on the homepage come from src/data/homepage.json,
// which you edit in the editor under Pages → Homepage.
const blurbs: Record<string, string> = {
  'south-africa': home.regionBlurbs?.southAfrica,
  africa: home.regionBlurbs?.africa,
  world: home.regionBlurbs?.world,
};
---

<Base>
  <section class="container hero">
    {home.eyebrow && <p class="eyebrow">{home.eyebrow}</p>}
    <h1>{home.headlineLine1} {home.headlineLine2 && <em>{home.headlineLine2}</em>}</h1>
    {home.intro && <p class="lede">{home.intro}</p>}
    <div class="hero__actions">
      {home.primaryButton?.label && <a class="btn btn--primary" href={home.primaryButton?.link || '/blog/'}>{home.primaryButton?.label}</a>}
      {home.secondaryButton?.label && <a class="btn btn--secondary" href={home.secondaryButton?.link || '/newsletter/'}>{home.secondaryButton?.label}</a>}
    </div>
  </section>

  {featured && (
    <section class="container" aria-label="Featured story">
      <PostCard post={featured} feature eager />
    </section>
  )}

  <section class="container section">
    <div class="section-head">
      <h2>{home.regionsHeading}</h2>
      <a href="/destinations/">All destinations →</a>
    </div>
    <div class="region-band">
      {Object.entries(REGIONS).map(([key, label]) => (
        <a class={`region-card region-card--${key}`} href={`/destinations/#${key}`}>
          <strong>{label}</strong>
          <span>{blurbs[key]}</span>
          <span>{count(key) === 0 ? 'Stories coming soon' : `${count(key)} ${count(key) === 1 ? 'story' : 'stories'}`}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container section" style="padding-top:0">
    <div class="section-head">
      <h2>{home.mapHeading ?? 'Where we\'ve been'}</h2>
      <a href="/map/">Open the full map →</a>
    </div>
    <TravelMap compact />
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>{home.latestHeading}</h2>
      <a href="/blog/">See every story →</a>
    </div>
    <div class="grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="container">
    <Newsletter />
  </section>
</Base>
